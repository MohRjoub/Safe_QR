<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/helpRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F6F7FB">

    <ScrollView
        android:id="@+id/scrollHelp"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:overScrollMode="never">

        <LinearLayout
            android:id="@+id/content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingTop="18dp"
            android:paddingEnd="16dp"
            android:paddingBottom="18dp">

            <TextView
                android:id="@+id/tvHelpTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Help"
                android:textStyle="bold"
                android:textSize="22sp"
                android:textColor="#0F172A"
                android:gravity="center"/>

            <TextView
                android:id="@+id/tvHelpSubtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:layout_marginBottom="14dp"
                android:text="Everything you need to scan safely with SafeQR."
                android:textSize="13sp"
                android:textColor="#64748B"
                android:gravity="center"/>

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                app:cardCornerRadius="18dp"
                app:cardElevation="2dp"
                app:strokeWidth="1dp"
                app:strokeColor="#E7EAF0"
                app:cardUseCompatPadding="true">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Welcome to SafeQR"
                        android:textStyle="bold"
                        android:textSize="15sp"
                        android:textColor="#0F172A"/>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="SafeQR helps you scan QR codes safely by showing a clear preview of the link and highlighting potential risks before you open any website. Use this page to learn the steps and features you need."
                        android:textSize="13sp"
                        android:textColor="#334155"
                        android:lineSpacingExtra="3dp"/>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                app:cardCornerRadius="18dp"
                app:cardElevation="2dp"
                app:strokeWidth="1dp"
                app:strokeColor="#E7EAF0"
                app:cardUseCompatPadding="true">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Getting started"
                        android:textStyle="bold"
                        android:textSize="15sp"
                        android:textColor="#0F172A"/>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_marginTop="12dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical">

                            <TextView
                                android:layout_width="22dp"
                                android:layout_height="22dp"
                                android:background="@drawable/bg_step_circle"
                                android:gravity="center"
                                android:text="1"
                                android:textStyle="bold"
                                android:textSize="12sp"
                                android:textColor="#0C8B84"/>

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:layout_marginStart="10dp"
                                android:text="Allow camera permission when SafeQR asks for it."
                                android:textSize="13sp"
                                android:textColor="#334155"
                                android:lineSpacingExtra="2dp"/>
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:layout_marginTop="10dp">

                            <TextView
                                android:layout_width="22dp"
                                android:layout_height="22dp"
                                android:background="@drawable/bg_step_circle"
                                android:gravity="center"
                                android:text="2"
                                android:textStyle="bold"
                                android:textSize="12sp"
                                android:textColor="#0C8B84"/>

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:layout_marginStart="10dp"
                                android:text="From the bottom bar, tap Scan to open the camera."
                                android:textSize="13sp"
                                android:textColor="#334155"
                                android:lineSpacingExtra="2dp"/>
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:layout_marginTop="10dp">

                            <TextView
                                android:layout_width="22dp"
                                android:layout_height="22dp"
                                android:background="@drawable/bg_step_circle"
                                android:gravity="center"
                                android:text="3"
                                android:textStyle="bold"
                                android:textSize="12sp"
                                android:textColor="#0C8B84"/>

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:layout_marginStart="10dp"
                                android:text="Point your camera at the QR code and keep it inside the frame."
                                android:textSize="13sp"
                                android:textColor="#334155"
                                android:lineSpacingExtra="2dp"/>
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:layout_marginTop="10dp">

                            <TextView
                                android:layout_width="22dp"
                                android:layout_height="22dp"
                                android:background="@drawable/bg_step_circle"
                                android:gravity="center"
                                android:text="4"
                                android:textStyle="bold"
                                android:textSize="12sp"
                                android:textColor="#0C8B84"/>

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:layout_marginStart="10dp"
                                android:text="Wait for SafeQR to read and analyze the QR code content."
                                android:textSize="13sp"
                                android:textColor="#334155"
                                android:lineSpacingExtra="2dp"/>
                        </LinearLayout>

                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                app:cardCornerRadius="18dp"
                app:cardElevation="2dp"
                app:strokeWidth="1dp"
                app:strokeColor="#E7EAF0"
                app:cardUseCompatPadding="true">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Scanning and opening a QR code"
                        android:textStyle="bold"
                        android:textSize="15sp"
                        android:textColor="#0F172A"/>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="Step-by-step"
                        android:textSize="12sp"
                        android:textColor="#64748B"/>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_marginTop="12dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical">

                            <TextView
                                android:layout_width="22dp"
                                android:layout_height="22dp"
                                android:background="@drawable/bg_step_circle"
                                android:gravity="center"
                                android:text="1"
                                android:textStyle="bold"
                                android:textSize="12sp"
                                android:textColor="#0C8B84"/>

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:layout_marginStart="10dp"
                                android:text="Tap Scan from the bottom navigation."
                                android:textSize="13sp"
                                android:textColor="#334155"
                                android:lineSpacingExtra="2dp"/>
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:layout_marginTop="10dp">

                            <TextView
                                android:layout_width="22dp"
                                android:layout_height="22dp"
                                android:background="@drawable/bg_step_circle"
                                android:gravity="center"
                                android:text="2"
                                android:textStyle="bold"
                                android:textSize="12sp"
                                android:textColor="#0C8B84"/>

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:layout_marginStart="10dp"
                                android:text="Allow camera access if prompted."
                                android:textSize="13sp"
                                android:textColor="#334155"
                                android:lineSpacingExtra="2dp"/>
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:layout_marginTop="10dp">

                            <TextView
                                android:layout_width="22dp"
                                android:layout_height="22dp"
                                android:background="@drawable/bg_step_circle"
                                android:gravity="center"
                                android:text="3"
                                android:textStyle="bold"
                                android:textSize="12sp"
                                android:textColor="#0C8B84"/>

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:layout_marginStart="10dp"
                                android:text="Hold your device 15–25 cm away from the QR code."
                                android:textSize="13sp"
                                android:textColor="#334155"
                                android:lineSpacingExtra="2dp"/>
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:layout_marginTop="10dp">

                            <TextView
                                android:layout_width="22dp"
                                android:layout_height="22dp"
                                android:background="@drawable/bg_step_circle"
                                android:gravity="center"
                                android:text="4"
                                android:textStyle="bold"
                                android:textSize="12sp"
                                android:textColor="#0C8B84"/>

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:layout_marginStart="10dp"
                                android:text="When the QR is detected, a preview panel appears with the full link and risk level."
                                android:textSize="13sp"
                                android:textColor="#334155"
                                android:lineSpacingExtra="2dp"/>
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:layout_marginTop="10dp">

                            <TextView
                                android:layout_width="22dp"
                                android:layout_height="22dp"
                                android:background="@drawable/bg_step_circle"
                                android:gravity="center"
                                android:text="5"
                                android:textStyle="bold"
                                android:textSize="12sp"
                                android:textColor="#0C8B84"/>

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:layout_marginStart="10dp"
                                android:text="Review the link and the risk message. If you trust it, tap Open Link."
                                android:textSize="13sp"
                                android:textColor="#334155"
                                android:lineSpacingExtra="2dp"/>
                        </LinearLayout>

                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                app:cardCornerRadius="18dp"
                app:cardElevation="2dp"
                app:strokeWidth="1dp"
                app:strokeColor="#E7EAF0"
                app:cardUseCompatPadding="true">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Understanding risk levels"
                        android:textStyle="bold"
                        android:textSize="15sp"
                        android:textColor="#0F172A"/>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="SafeQR shows a simple risk label with a short explanation:"
                        android:textSize="13sp"
                        android:textColor="#64748B"/>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="• SAFE — Domain and content look normal and safe."
                        android:textColor="#16A34A"
                        android:textStyle="bold"
                        android:textSize="13sp"/>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="• UNKNOWN — New or uncommon website. Proceed carefully."
                        android:textColor="#F59E0B"
                        android:textStyle="bold"
                        android:textSize="13sp"/>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="• SUSPICIOUS — Shorteners, strange characters, or domains that don’t match the brand."
                        android:textColor="#DC2626"
                        android:textStyle="bold"
                        android:textSize="13sp"/>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                app:cardCornerRadius="18dp"
                app:cardElevation="2dp"
                app:strokeWidth="1dp"
                app:strokeColor="#E7EAF0"
                app:cardUseCompatPadding="true">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Permissions and privacy"
                        android:textStyle="bold"
                        android:textSize="15sp"
                        android:textColor="#0F172A"/>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_marginTop="12dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:layout_marginBottom="10dp">

                            <TextView
                                android:layout_width="22dp"
                                android:layout_height="22dp"
                                android:background="@drawable/bg_step_circle"
                                android:text="1"
                                android:textColor="#0C8B84"
                                android:textStyle="bold"
                                android:textSize="12sp"
                                android:gravity="center"
                                android:layout_marginEnd="12dp"/>

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="Camera — Used only to read QR codes."
                                android:textSize="13sp"
                                android:textColor="#334155"
                                android:lineSpacingExtra="2dp"/>
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:layout_marginBottom="10dp">

                            <TextView
                                android:layout_width="22dp"
                                android:layout_height="22dp"
                                android:background="@drawable/bg_step_circle"
                                android:text="2"
                                android:textColor="#0C8B84"
                                android:textStyle="bold"
                                android:textSize="12sp"
                                android:gravity="center"
                                android:layout_marginEnd="12dp"/>

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="Network — Used to check the link and fetch security information."
                                android:textSize="13sp"
                                android:textColor="#334155"
                                android:lineSpacingExtra="2dp"/>
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical">

                            <TextView
                                android:layout_width="22dp"
                                android:layout_height="22dp"
                                android:background="@drawable/bg_step_circle"
                                android:text="3"
                                android:textColor="#0C8B84"
                                android:textStyle="bold"
                                android:textSize="12sp"
                                android:gravity="center"
                                android:layout_marginEnd="12dp"/>

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="History — Stored in your account history unless you delete it."
                                android:textSize="13sp"
                                android:textColor="#334155"
                                android:lineSpacingExtra="2dp"/>
                        </LinearLayout>

                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>


            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                app:cardCornerRadius="18dp"
                app:cardElevation="2dp"
                app:strokeWidth="1dp"
                app:strokeColor="#E7EAF0"
                app:cardUseCompatPadding="true">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Scan history"
                        android:textStyle="bold"
                        android:textSize="15sp"
                        android:textColor="#0F172A"/>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_marginTop="12dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:layout_marginBottom="10dp">

                            <TextView
                                android:layout_width="22dp"
                                android:layout_height="22dp"
                                android:background="@drawable/bg_step_circle"
                                android:text="1"
                                android:textColor="#0C8B84"
                                android:textStyle="bold"
                                android:textSize="12sp"
                                android:gravity="center"
                                android:layout_marginEnd="12dp"/>

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="Tap History to see the QR codes you scanned."
                                android:textSize="13sp"
                                android:textColor="#334155"
                                android:lineSpacingExtra="2dp"/>
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:layout_marginBottom="10dp">

                            <TextView
                                android:layout_width="22dp"
                                android:layout_height="22dp"
                                android:background="@drawable/bg_step_circle"
                                android:text="2"
                                android:textColor="#0C8B84"
                                android:textStyle="bold"
                                android:textSize="12sp"
                                android:gravity="center"
                                android:layout_marginEnd="12dp"/>

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="Each entry shows the URL, risk level, and scan time."
                                android:textSize="13sp"
                                android:textColor="#334155"
                                android:lineSpacingExtra="2dp"/>
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical">

                            <TextView
                                android:layout_width="22dp"
                                android:layout_height="22dp"
                                android:background="@drawable/bg_step_circle"
                                android:text="3"
                                android:textColor="#0C8B84"
                                android:textStyle="bold"
                                android:textSize="12sp"
                                android:gravity="center"
                                android:layout_marginEnd="12dp"/>

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="Tap an item to open details or recheck it again."
                                android:textSize="13sp"
                                android:textColor="#334155"
                                android:lineSpacingExtra="2dp"/>
                        </LinearLayout>

                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>


            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                app:cardCornerRadius="18dp"
                app:cardElevation="2dp"
                app:strokeWidth="1dp"
                app:strokeColor="#E7EAF0"
                app:cardUseCompatPadding="true">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Account and profile"
                        android:textStyle="bold"
                        android:textSize="15sp"
                        android:textColor="#0F172A"/>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_marginTop="12dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:layout_marginBottom="10dp">

                            <TextView
                                android:layout_width="22dp"
                                android:layout_height="22dp"
                                android:background="@drawable/bg_step_circle"
                                android:text="1"
                                android:textColor="#0C8B84"
                                android:textStyle="bold"
                                android:textSize="12sp"
                                android:gravity="center"
                                android:layout_marginEnd="12dp"/>

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="Use Profile to see and update your name, email, and phone."
                                android:textSize="13sp"
                                android:textColor="#334155"
                                android:lineSpacingExtra="2dp"/>
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:layout_marginBottom="10dp">

                            <TextView
                                android:layout_width="22dp"
                                android:layout_height="22dp"
                                android:background="@drawable/bg_step_circle"
                                android:text="2"
                                android:textColor="#0C8B84"
                                android:textStyle="bold"
                                android:textSize="12sp"
                                android:gravity="center"
                                android:layout_marginEnd="12dp"/>

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
